<?xml version="1.0"?>
<!-- Fragment injected into the expanded upstream X500 base_link at runtime.
     No additional mass, collision, motor or flight sensor modifications. -->
<sensor name="thermal_camera" type="thermal">
  <!-- Camera +X points down after +90 degrees around Y. -->
  <pose>0 0 -0.12 0 1.5707963267948966 0</pose>
  <gz_frame_id>x500_1/thermal_camera_optical</gz_frame_id>
  <always_on>true</always_on>
  <update_rate>8</update_rate>
  <topic>/thermoswarm/x500_1/thermal/image</topic>
  <camera>
    <horizontal_fov>1.5707963267948966</horizontal_fov>
    <image><width>320</width><height>240</height><format>L8</format></image>
    <clip><near>0.03</near><far>40</far></clip>
  </camera>
  <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
    <min_temp>250</min_temp><max_temp>700</max_temp><resolution>3.0</resolution>
  </plugin>
</sensor>
