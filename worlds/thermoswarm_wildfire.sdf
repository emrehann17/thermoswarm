<?xml version="1.0"?>
<!-- Fixed 300 K background / 600 K patch; no fire propagation or smoke physics. -->
<sdf version="1.9">
  <world name="thermoswarm_wildfire">
    <physics name="px4" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic">
      <temperature>300</temperature>
    </atmosphere>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>.5 .5 .5 1</ambient>
      <background>.7 .8 .9 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 50 0 0 0</pose>
      <diffuse>.8 .8 .8 1</diffuse>
      <direction>-.3 .2 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -.05 0 0 0</pose>
      <link name="link">
        <visual name="ground">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>60 60 .1</size>
            </box>
          </geometry>
          <material>
            <ambient>.25 .4 .18 1</ambient>
            <diffuse>.25 .4 .18 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>300</temperature>
          </plugin>
        </visual>
        <collision name="ground_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>60 60 .1</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="fire_patch">
      <static>true</static>
      <pose>1 1 .006 0 0 0</pose>
      <link name="link">
        <visual name="hot_surface">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>1.2 1.2 .01</size>
            </box>
          </geometry>
          <material>
            <ambient>.9 .15 .02 1</ambient>
            <diffuse>.9 .15 .02 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>600</temperature>
          </plugin>
        </visual>
      </link>
    </model>
    <model name="ambient_patch">
      <static>true</static>
      <pose>-1 1 .006 0 0 0</pose>
      <link name="link">
        <visual name="cool_surface">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
